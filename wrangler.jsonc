// Cloudflare Workers config for the OpenNext build. Deploy with `pnpm deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cakes-by-ish",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cakes-by-ish",
    },
  ],
  // D1 database. Replace database_id with the id from `wrangler d1 create cakes-by-ish` (in Ishani's
  // account) before deploying; local dev works with the placeholder. Migrations come from drizzle-kit.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cakes-by-ish",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
